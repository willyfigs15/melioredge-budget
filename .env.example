# Root compose env (used by docker-compose to build images)
DB_USER=postgres
DB_PASSWORD=change-me

# Frontend build args — point at the backend + dashboard the frontend should call
NEXT_PUBLIC_API_URL=http://localhost:8005
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002
