# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/melioredge_budget

# Must match dashboard SECRET_KEY/ALGORITHM so handoff tokens validate
SECRET_KEY=change-me-in-production-match-dashboard
ALGORITHM=HS256

# Token lifetimes (moderate-security defaults, aligned with dashboard)
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# CORS — comma-separated origins (dev + prod)
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3002,https://budget.melioredge.com,https://dashboard.melioredge.com

# Cookies
COOKIE_ACCESS_NAME=mel_budget_access
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_PATH=/

ENVIRONMENT=development
